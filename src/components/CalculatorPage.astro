---
import CalcCard from './CalcCard.astro';
import Base from '../layouts/Base.astro';
import CalcForm from './CalcForm.astro';
import { SITE } from '../site.config';
import { bySlug, CATEGORIES } from '../lib/registry';
import { renderChart, chartTable } from '../lib/chart';
import { defaults, describeInputs, resultExtraHtml, resultHtml, tableHtml } from '../lib/render';
import type { Calculator } from '../lib/types';
import { Image, getImage } from 'astro:assets';
import { calcImages, imageAlt } from '../lib/images';

interface Props {
  calc: Calculator;
}
const { calc } = Astro.props;
const cat = CATEGORIES[calc.category];
const url = `${SITE.url}/${calc.slug}/`;

const values = defaults(calc.inputs);
const result = calc.compute(values);
const ansVals = defaults(calc.inputs, calc.answer.inputs ?? {});
const answer = calc.answer.text(calc.compute(ansVals), ansVals);
const examples = calc.examples.map((ex) => {
  const v = defaults(calc.inputs, ex.inputs);
  const r = calc.compute(v);
  return { ...ex, v, r, text: ex.explain(r, v), summary: describeInputs(calc.inputs, v) };
});
const analysis = calc.analysis();
const related = calc.related.map((s) => bySlug[s]).filter(Boolean);
const img = calcImages[calc.slug];
const alt = imageAlt(calc.slug, calc.name);
// Social-share image: JPEG (best supported by WhatsApp/Facebook/LinkedIn), max 1200 px wide
const og = img ? await getImage({ src: img, width: Math.min(1200, img.width), format: 'jpg', quality: 82 }) : null;
const ogImage = og ? { url: new URL(og.src, SITE.url).href, width: og.attributes.width as number, height: og.attributes.height as number, alt } : undefined;

const appCat: Record<string, string> = {
  finance: 'FinanceApplication',
  payroll: 'FinanceApplication',
  health: 'HealthApplication',
  education: 'EducationalApplication',
  math: 'EducationalApplication',
};
const disclaimers: Record<string, string> = {
  finance:
    'Results are estimates for educational purposes and are not financial advice. Lenders and institutions may calculate differently; confirm figures with them before deciding.',
  tax: 'Tax figures use published 2026 US federal rules and simplified state handling. They are estimates, not tax advice. Your employer, the IRS or a tax professional has the final word.',
  health:
    'This calculator gives general estimates and is not medical advice. Formulas describe populations, not individuals. Talk to a doctor or registered dietitian before making health decisions.',
  general: 'Results are estimates. Double-check anything important before relying on it.',
};
const pregnancySlugs = new Set(['pregnancy-calculator', 'ovulation-calculator', 'due-date-calculator']);
const disclaimer = pregnancySlugs.has(calc.slug)
  ? 'This calculator gives general estimates and is not medical advice. Cycles and pregnancies vary. Talk to your obstetrician, midwife or fertility clinic about your own dates.'
  : disclaimers[calc.disclaimer ?? 'general'];
const founder = { '@id': SITE.url + '/about/#founder' };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': url + '#app',
    name: calc.name,
    url,
    applicationCategory: appCat[calc.category] ?? 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    browserRequirements: 'Requires JavaScript for live results',
    description: calc.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@id': SITE.url + '/#org' },
    ...(ogImage ? { image: ogImage.url } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': url + '#webpage',
    name: calc.title,
    url,
    description: calc.description,
    datePublished: SITE.launched,
    dateModified: SITE.lastReviewed,
    inLanguage: 'en-US',
    isPartOf: { '@id': SITE.url + '/#website' },
    author: founder,
    publisher: { '@id': SITE.url + '/#org' },
    mainEntity: { '@id': url + '#app' },
    breadcrumb: { '@id': url + '#breadcrumb' },
    about: { '@type': 'Thing', name: calc.keyword },
    ...(ogImage ? { primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.url, width: ogImage.width, height: ogImage.height } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': url + '#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/${cat.slug}/` },
      { '@type': 'ListItem', position: 3, name: calc.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [...calc.faqs, ...calc.variantQs].map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={calc.title} description={calc.description} jsonLd={jsonLd} image={ogImage}>
  <!-- 1. DARK: H1, answer block, calculator -->
  <section class="dark calc-hero">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/">Home</a></li>
          <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
          <li aria-current="page">{calc.name}</li>
        </ol>
      </nav>
      <h1 class="h-hero">{calc.name} <span class="script" style="color:var(--accent)">{calc.accent}</span></h1>
      <p class="answer" set:html={answer} />
      <p class="small muted byline">
        By <a href="/about/">{SITE.founder}</a> · Last reviewed
        <time datetime={SITE.lastReviewed}>{new Date(SITE.lastReviewed + 'T12:00').toLocaleDateString('en-US', { dateStyle: 'long' })}</time>
      </p>
      <div class="calc-grid">
        <div class="panel">
          <CalcForm calc={calc} values={values} />
        </div>
        <div class="result-card" aria-labelledby="result-h">
          <div class="orb" aria-hidden="true">=</div>
          <h2 id="result-h" class="sr-only">Your result</h2>
          <div data-result set:html={resultHtml(result)} />
          <p class="sr-only" aria-live="polite" data-live></p>
          <div class="result-tools">
            <button type="button" class="btn btn-sm" data-copy>Copy result</button>
            <button type="button" class="btn btn-sm" data-share>Share link</button>
            <button type="button" class="btn btn-sm" data-print>Print</button>
          </div>
        </div>
      </div>
      <div class="result-extra" data-result-extra set:html={resultExtraHtml(result)} />
    </div>
  </section>

  <!-- 2. LIGHT: understanding the calculator -->
  <section class="light sec">
    <div class="wrap">
      <div class:list={['understand', img && 'has-img']}>
        <div class="prose">
          <p class="label muted">Understand it</p>
          <h2>What the {calc.name} Does</h2>
          {calc.intro.map((p) => <p set:html={p} />)}
        </div>
        {
          img && (
            <figure class="calc-figure" style={`max-width:${Math.round(img.width * 1.5)}px`}>
              <Image
                src={img}
                alt={alt}
                widths={[320, 480, 640, 800].filter((w) => w <= img.width).concat(img.width < 320 ? [img.width] : [])}
                sizes="(max-width: 900px) 100vw, 420px"
                loading="lazy"
                decoding="async"
              />
            </figure>
          )
        }
      </div>
      <div class="prose">
        <h2 style="margin-top:3rem">How the {calc.short} Formula Works</h2>
        <div class="formula" aria-label="Formula">{calc.formula.expr}</div>
        <dl class="vars">
          {
            calc.formula.vars.map(([k, d]) => (
              <>
                <dt>{k}</dt>
                <dd>{d}</dd>
              </>
            ))
          }
        </dl>
        {calc.formula.notes?.map((n) => <p set:html={n} />)}
      </div>

      <h2 class="h-sec" style="margin-top:4rem">Worked Examples</h2>
      <div class="three-col">
        {
          examples.map((ex) => (
            <article class="dot-card">
              <h3>{ex.title}</h3>
              <p class="ex-inputs">{ex.summary}</p>
              <p class="ex-result">
                <small>{ex.r.primary.label}</small>
                {ex.r.primary.value}
              </p>
              <p class="small" set:html={ex.text} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. DARK: unique analysis, graph-first -->
  <section class="dark sec" aria-labelledby="analysis-h">
    <div class="wrap">
      <p class="label muted">Original analysis</p>
      <h2 id="analysis-h" class="h-sec">{calc.short} Analysis <span class="script" style="color:var(--accent)">in numbers</span></h2>
      <p class="lead muted">
        Every chart below is generated from the same tested formula that powers the calculator above, so you can see the patterns behind a
        single result.
      </p>
      {
        analysis.map((b) => {
          const t = b.table ?? (b.chart ? chartTable(b.chart) : undefined);
          return (
            <div class="analysis-block">
              <div>
                {b.chart && <Fragment set:html={renderChart(b.chart)} />}
                {t && (
                  <details class="table-toggle">
                    <summary>View data table</summary>
                    <Fragment set:html={tableHtml(t)} />
                  </details>
                )}
              </div>
              <div class="analysis-text">
                <h3>{b.title}</h3>
                <p set:html={b.insight} />
                {b.stats && (
                  <div class="stat-row">
                    {b.stats.map((s) => (
                      <div class="stat">
                        <b>{s.value}</b>
                        <span>{s.label}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- 4. LIGHT: reference, variant questions, tips -->
  <section class="light sec">
    <div class="wrap">
      {
        calc.reference && (
          <div style="margin-bottom:4rem">
            <h2 class="h-sec">{calc.reference.caption ?? `${calc.short} Reference Table`}</h2>
            {(calc.reference.asOf || calc.reference.source) && (
              <p class="small muted">
                {calc.reference.asOf && <>As of {calc.reference.asOf}. </>}
                {calc.reference.source && <>Source: {calc.reference.source}</>}
              </p>
            )}
            <Fragment set:html={tableHtml({ ...calc.reference, caption: undefined })} />
          </div>
        )
      }
      <div class="two-col" style="gap:3rem">
        <div class="prose">
          <h2>Common {calc.short} Questions</h2>
          {
            calc.variantQs.map((q) => (
              <>
                <h3>{q.q}</h3>
                <p set:html={q.a} />
              </>
            ))
          }
        </div>
        <div class="prose">
          <h2>Tips and Common Mistakes</h2>
          <ul>
            {calc.tips.map((t) => <li set:html={t} />)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. LIGHT: FAQ accordion -->
  <section class="light sec" style="padding-top:0" aria-labelledby="faq-h">
    <div class="wrap">
      <h2 id="faq-h" class="h-sec" style="text-align:center">Frequently asked <span class="script">questions</span></h2>
      <div class="faq">
        {
          calc.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <div class="a">
                <p set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Gradient CTA: related calculators -->
  <section class="light" style="padding-bottom:var(--section)">
    <div class="wrap">
      <div class="cta-card">
        <div class="orb" aria-hidden="true">+</div>
        <div>
          <h2 class="h-sec" style="color:#fff">Keep going with <span class="script">related tools</span></h2>
          <p>Calculators for the next question people usually ask after this one.</p>
        </div>
        <div class="card-grid" style="grid-column:1/-1">
          {
            related.map((r, i) => (
              <CalcCard calc={r} index={i} sub={`${r.description.split('. ')[0].slice(0, 70)}…`} />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 7. DARK: sources, review, disclaimer -->
  <section class="dark sec-tight">
    <div class="wrap">
      <div class="two-col">
        <div>
          <h2 style="font-size:1.25rem">Sources and methodology</h2>
          <ul class="small src-list" style="padding-left:1.1rem">
            {
              calc.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank">
                    {s.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/methodology/">How we build and test our calculators</a></li>
          </ul>
        </div>
        <div>
          <h2 style="font-size:1.25rem">Last reviewed</h2>
          <p class="small muted">
            <time datetime={SITE.lastReviewed}>{new Date(SITE.lastReviewed + 'T12:00').toLocaleDateString('en-US', { dateStyle: 'long' })}</time> by
            <a href="/about/">{SITE.founder}</a>. Runs through our automated test suite on every build.
          </p>
          <p class="small muted">{disclaimer}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initCalculator } from '../lib/engine';
  const form = document.querySelector<HTMLFormElement>('form[data-calc]');
  if (form) initCalculator(form);
</script>
