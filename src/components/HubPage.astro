---
import CalcCard from './CalcCard.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import type { categoryList } from '../lib/registry';

interface Props {
  hub: (typeof categoryList)[number];
}
const { hub } = Astro.props;
const url = `${SITE.url}/${hub.slug}/`;
const n = hub.items.length;
const fullTitle = `${hub.name} – ${n} Free ${n === 1 ? 'Tool' : 'Tools'} | ${SITE.name}`;
// Keep titles within ~60 characters so search results don't truncate them.
const title = fullTitle.length <= 60 ? fullTitle : `${hub.name} – ${n} Free ${n === 1 ? 'Tool' : 'Tools'}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.name,
    url,
    description: hub.blurb,
    hasPart: hub.items.map((c) => ({ '@type': 'WebApplication', name: c.name, url: `${SITE.url}/${c.slug}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: hub.name, item: url },
    ],
  },
];
---

<Base noindex={n < 2} title={title} description={`${hub.blurb} ${n} free ${n === 1 ? 'calculator' : 'calculators'} with charts, worked examples and FAQs.`.slice(0, 160)} jsonLd={jsonLd}>
  <section class="dark calc-hero">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">{hub.name}</li></ol>
      </nav>
      <h1 class="h-hero">{hub.name} <span class="script" style="color:var(--accent)">{hub.accent}</span></h1>
      <p class="lead muted">{hub.blurb}</p>
      <div class="card-grid" style="margin-top:2.5rem">
        {
          hub.items.map((c, i) => (
            <CalcCard calc={c} index={i} />
          ))
        }
      </div>
    </div>
  </section>
  <section class="dark sec" style="padding-top:0">
    <div class="wrap prose">
      <h2 style="font-size:1.5rem">What these calculators cover</h2>
      <p>{hub.intro}</p>
    </div>
  </section>
  <section class="light sec">
    <div class="wrap prose">
      <h2>Which {hub.name.replace(' Calculators', '').toLowerCase()} calculator do I need?</h2>
      <ul>
        {
          hub.items.map((c) => (
            <li>
              <a href={`/${c.slug}/`}>
                <strong>{c.name}</strong>
              </a>{' '}
              — {c.description}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
