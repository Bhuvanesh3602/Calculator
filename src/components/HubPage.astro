---
import CalcCard from './CalcCard.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { renderChart } from '../lib/chart';
import type { categoryList } from '../lib/registry';

interface Props {
  hub: (typeof categoryList)[number];
}
const { hub } = Astro.props;
const keyClass = ['k-orange', 'k-pink', 'k-blue', 'k-green', 'k-yellow'];
const url = `${SITE.url}/${hub.slug}/`;
const top = hub.items.slice(0, 10);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.name,
    url,
    description: hub.blurb,
    hasPart: hub.items.map((c) => ({ '@type': 'WebApplication', name: c.name, url: `${SITE.url}/${c.slug}/` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: hub.name, item: url },
    ],
  },
];
---

<Base title={`${hub.name} – ${hub.items.length} Free Tools | ${SITE.name}`} description={`${hub.blurb} ${hub.items.length} free calculators with charts, worked examples and FAQs.`.slice(0, 160)} jsonLd={jsonLd}>
  <section class="dark calc-hero">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">{hub.name}</li></ol>
      </nav>
      <h1 class="h-hero">{hub.name} <span class="script" style="color:var(--accent)">{hub.accent}</span></h1>
      <p class="lead muted">{hub.blurb}</p>
      <div class="card-grid" style="margin-top:2.5rem">
        {
          hub.items.map((c, i) => (
            <CalcCard calc={c} index={i} />
          ))
        }
      </div>
    </div>
  </section>
  {
    top.length > 1 && (
      <section class="dark sec" style="padding-top:0">
        <div class="wrap">
          <div class="analysis-block">
            <div>
              <Fragment
                set:html={renderChart({
                  type: 'hbar',
                  title: `Monthly US searches for ${hub.name.toLowerCase()}`,
                  x: top.map((c) => c.name),
                  series: [{ name: 'Monthly searches', values: top.map((c) => c.volume) }],
                  y: 'int',
                })}
              />
            </div>
            <div class="analysis-text">
              <h2 style="font-size:1.5rem">What people calculate most</h2>
              <p>
                Approximate monthly search demand from our keyword research (Google Keyword Planner, November 2026). The {top[0].name.toLowerCase()} leads this group, which is why we built it with the most scenarios.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }
  <section class="light sec">
    <div class="wrap prose">
      <h2>Which {hub.name.replace(' Calculators', '').toLowerCase()} calculator do I need?</h2>
      <ul>
        {
          hub.items.map((c) => (
            <li>
              <a href={`/${c.slug}/`}>
                <strong>{c.name}</strong>
              </a>{' '}
              — {c.description}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
