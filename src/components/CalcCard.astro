---
/** Calculator link card. Shows the calculator's image if one exists, otherwise a coloured key badge. */
import { Image } from 'astro:assets';
import { calcImages } from '../lib/images';
import type { Calculator } from '../lib/types';

interface Props {
  calc: Calculator;
  index: number;
  sub?: string;
  [key: string]: any;
}
const { calc, index, sub, ...rest } = Astro.props;
const keyClass = ['k-orange', 'k-pink', 'k-blue', 'k-green', 'k-yellow'];
const img = calcImages[calc.slug];
---

<a class="calc-card" href={`/${calc.slug}/`} {...rest}>
  {
    img ? (
      <Image src={img} alt="" width={96} height={96} densities={[1, 2]} fit="cover" class="calc-thumb" loading="lazy" decoding="async" />
    ) : (
      <span class:list={['key-badge', keyClass[index % 5]]} aria-hidden="true">
        {calc.icon}
      </span>
    )
  }
  <span>
    <b>{calc.name}</b>
    <span>{sub ?? calc.accent}</span>
  </span>
</a>
