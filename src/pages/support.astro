---
import TextPage from '../components/TextPage.astro';
import { SITE } from '../site.config';

const paypalEmail = SITE.paypalEmail;
const defaultAmount = SITE.supportDefaultAmount.toFixed(2);
const presets = ['3.00', defaultAmount, '15.00', '25.00'];
const itemName = `Support ${SITE.name}`;
---

<TextPage
  title={`Support My Work – Help Keep ${SITE.name} Free`}
  description={`${SITE.name} is built by an independent student developer. A small PayPal contribution helps add more calculators and keep every tool free.`}
  h1="Support My Work"
  accent="keep it free"
>
  <p>Hi! I'm a college student and independent developer building free online calculators to help people with everyday calculations.</p>
  <p>I don't have a big budget to build and maintain large products, but I'm trying my best to create useful tools for everyone.</p>
  <p>If this website has helped you, please consider supporting me through a small contribution.</p>
  <p>Your support will help me improve this website, add more calculators, and keep the tools free for everyone.</p>
  <p><strong>Every little contribution means a lot to me!</strong></p>

  <form
    class="checkout"
    data-checkout
    data-email={paypalEmail}
    data-item={itemName}
    aria-labelledby="checkout-title"
  >
    <header class="checkout-head">
      <span class="checkout-logo" aria-hidden="true">❤</span>
      <span id="checkout-title" class="checkout-brand">Support {SITE.name}</span>
    </header>

    <div class="checkout-body">
      <!-- Left: payment options -->
      <fieldset class="checkout-col">
        <legend class="checkout-legend">Choose one of the payment options</legend>

        <label class="pay-opt">
          <input type="radio" name="method" value="paypal" checked />
          <span class="pay-opt-icon pay-opt-icon--pp" aria-hidden="true">P</span>
          <span class="pay-opt-text">
            <strong>PayPal</strong>
            <small>Log in and pay with your PayPal balance or saved card.</small>
          </span>
        </label>

        <label class="pay-opt">
          <input type="radio" name="method" value="card" />
          <span class="pay-opt-icon" aria-hidden="true">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19M6.5 15h4"/></svg>
          </span>
          <span class="pay-opt-text">
            <strong>Pay by card</strong>
            <small>Visa, Mastercard, Amex or Discover — no PayPal account needed.</small>
          </span>
        </label>

        <label class="pay-opt">
          <input type="radio" name="method" value="direct" />
          <span class="pay-opt-icon" aria-hidden="true">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11.5 21 4l-7.5 18-2.5-8z"/><path d="m11 14 10-10"/></svg>
          </span>
          <span class="pay-opt-text">
            <strong>Send directly</strong>
            <small>Use <em>Send</em> in your PayPal app to:</small>
            <span class="pay-direct">
              <span class="mono" data-email>{paypalEmail}</span>
              <button type="button" class="pay-copy" data-copy>Copy</button>
            </span>
          </span>
        </label>
      </fieldset>

      <!-- Right: summary -->
      <div class="checkout-col">
        <div class="summary">
          <p class="summary-label">Total amount</p>
          <p class="summary-total" aria-live="polite">
            <span>$</span><span data-total>{defaultAmount}</span>
            <small>USD</small>
          </p>

          <div class="amounts" role="radiogroup" aria-label="Choose an amount">
            {presets.map((v) => (
              <button
                type="button"
                class="amount-chip"
                data-amount={v}
                role="radio"
                aria-checked={v === defaultAmount ? 'true' : 'false'}
              >
                ${v.replace(/\.00$/, '')}
              </button>
            ))}
          </div>
          <label class="amount-custom">
            <span>Other</span>
            <span class="amount-input">
              $<input type="number" inputmode="decimal" min="1" max="10000" step="0.01" placeholder="Custom" data-custom />
            </span>
          </label>

          <div class="summary-line">
            <span>☕ {itemName}</span>
            <span>$<span data-line>{defaultAmount}</span></span>
          </div>
        </div>

        <div class="secure">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.3" fill="currentColor"/></svg>
          <p>Your payment is 100% safe and secure. Checkout happens on PayPal — I never see or store your card details.</p>
        </div>

        <button type="submit" class="checkout-go" data-go>
          <span data-go-label>Continue to PayPal</span>
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </form>

  <p>Thank you for supporting an independent student developer! ❤️</p>
</TextPage>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-checkout]');
  if (form) {
    const email = form.dataset.email ?? '';
    const item = form.dataset.item ?? 'Support';
    const totalEl = form.querySelector('[data-total]')!;
    const lineEl = form.querySelector('[data-line]')!;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-amount]')];
    const custom = form.querySelector<HTMLInputElement>('[data-custom]')!;
    const goLabel = form.querySelector('[data-go-label]')!;
    const copyBtn = form.querySelector<HTMLButtonElement>('[data-copy]')!;

    let amount = chips.find((c) => c.getAttribute('aria-checked') === 'true')?.dataset.amount ?? '7.90';

    const show = (v: string) => {
      totalEl.textContent = v;
      lineEl.textContent = v;
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
        custom.value = '';
        amount = chip.dataset.amount!;
        show(amount);
      }),
    );

    custom.addEventListener('input', () => {
      const n = parseFloat(custom.value);
      if (n >= 1) {
        chips.forEach((c) => c.setAttribute('aria-checked', 'false'));
        amount = n.toFixed(2);
        show(amount);
      }
    });

    const method = () => (new FormData(form).get('method') as string) ?? 'paypal';
    const labels: Record<string, string> = {
      paypal: 'Continue to PayPal',
      card: 'Continue to card payment',
      direct: 'Copy email & open PayPal',
    };
    form.addEventListener('change', () => (goLabel.textContent = labels[method()]));

    const copyEmail = async () => {
      try {
        await navigator.clipboard.writeText(email);
        copyBtn.textContent = 'Copied ✓';
      } catch {
        copyBtn.textContent = 'Failed';
      }
      setTimeout(() => (copyBtn.textContent = 'Copy'), 2000);
    };
    copyBtn.addEventListener('click', (e) => {
      e.preventDefault();
      copyEmail();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const m = method();
      if (m === 'direct') {
        copyEmail();
        window.open('https://www.paypal.com/myaccount/transfer/homepage/pay', '_blank', 'noopener');
        return;
      }
      // Standard PayPal checkout straight to the receiving email, amount pre-filled.
      const params = new URLSearchParams({
        cmd: '_xclick',
        business: email,
        item_name: item,
        amount,
        currency_code: 'USD',
        no_shipping: '1',
      });
      if (m === 'card') params.set('landing_page', 'billing'); // open on the guest card form
      window.open(`https://www.paypal.com/cgi-bin/webscr?${params}`, '_blank', 'noopener');
    });
  }
</script>
